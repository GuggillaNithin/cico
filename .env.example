# Attendance Bot Environment Variables Example
# Copy this file to .env and fill in your actual credentials

# URL Configuration
# Example: https://update-tool-five.vercel.app/
ATTENDANCE_URL=https://update-tool-five.vercel.app/

# Authentication (Google Sign-In)
GOOGLE_EMAIL=your_gmail_here
GOOGLE_PASSWORD=your_gmail_password_here

# Email Notification Settings (SMTP)
# Using Gmail SMTP by default
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=nithinguggilla
# Use an App Password for Gmail, not your main password
SMTP_PASSWORD=
ALERT_EMAIL_RECIPIENT=
